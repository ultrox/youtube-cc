# Chrome Web Store API v2 credentials: the same four values as every other extension under your
# publisher account. Copy to .env (gitignored) for local `pnpm release --dry-run` / `pnpm store-status`;
# in CI they are secrets of the GitHub environment "chrome-web-store". Walkthrough: docs/publishing.md
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=
CHROME_PUBLISHER_ID=
