{
  "name": "youtube-cc",
  "description": "Only the subtitle languages you actually use: pick your few languages once, then switch YouTube captions in one click.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "webStore": {
    "chrome": ""
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:live": "LIVE=1 playwright test e2e/live.spec.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e",
    "icons": "node scripts/icons.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release.mjs",
    "store-status": "node --env-file-if-exists=.env scripts/store-status.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  }
}
